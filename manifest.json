{
  "manifest_version": 3,
  "name": "Ruler",
  "version": "1.3.0",
  "description": "Measure the space between elements and inspect the Carbon tokens they use, inside shadow DOM and Storybook iframes.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Ruler",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  },
  "commands": {
    "toggle-ruler": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Turn the ruler on or off"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
